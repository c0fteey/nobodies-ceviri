generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                 Int      @id @default(1)
  setupCompleted     Boolean  @default(false)
  siteUrl            String   @db.VarChar(512)
  discordClientId    String   @db.VarChar(128)
  discordClientSecret String  @db.Text
  adminDiscordId     String   @db.VarChar(64)
  adminUsername      String   @db.VarChar(128)
  adminAvatar        String?  @db.VarChar(512)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
