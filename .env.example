# === Zorunlu (Vercel Environment Variables) ===
AUTH_SECRET="uzun-rastgele-secret"
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"
AUTH_TRUST_HOST="true"

AUTH_DISCORD_ID="discord-client-id"
AUTH_DISCORD_SECRET="discord-client-secret"
ADMIN_DISCORD_ID="discord-user-id"
ADMIN_DISCORD_USERNAME="AdminName"

# TiDB / MySQL (Vercel localhost'a erişemez)
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/nbdsx_staff?sslaccept=strict"

# Kurulum bitti bayrağı (Vercel'de wizard yerine)
SETUP_COMPLETED="1"

# nMonitor offline eşiği (saniye) — plugin config heartbeat.stale-after-seconds ile uyumlu tut
NMONITOR_STALE_SECONDS="45"

# === Sadece local ===
# DEV_BYPASS="1"
